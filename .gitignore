# The control stack is its own git repo (pi-drg/picar_freenove_fastapi).
# Clone it here; do not vendor it into this workspace's history.
/picar_freenove_fastapi/

# Upstream Freenove code and docs — fetched, not ours to redistribute.
# tools/fetch-reference.sh repopulates this.
/reference/

# three.js, vendored for offline use. tools/fetch-viewer-libs.sh repopulates it.
/viewer/lib/

# Diagnostic output captured off the Pi.
/notes/runs/

# Freenove's CAD — 69 MB of STEP plus the zip it came in. Not ours to vendor,
# and viewer/car.glb regenerates from it with tools/step2glb.py.
/cad_design/
/viewer/car.glb

__pycache__/
*.pyc
.venv/
.DS_Store
.lgd-nfy*

# The CAD env is ~600 MB of OpenCASCADE wheels. tools/setup-cad-env.sh rebuilds it.
/tools/cadenv
# 669k-point sample of the car, regenerated by tools/analyse3.py (26 MB).
/cover/carpoints.npy

# Local scratch
.DS_Store
**/.DS_Store
